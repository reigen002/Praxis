# Copy to .env. Never commit credentials.
LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Optional compatible endpoint; existing ANTHROPIC_AUTH_TOKEN also supported.
# ANTHROPIC_BASE_URL=
# Default provider: set OPENAI_API_KEY privately before a live run.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Free-tier option: set LLM_PROVIDER=groq and add your Groq key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
DECISION_PROVIDER=rules
# Full key created at https://jev-ai.org/settings/apikeys/ (sk-glm5-...), not an OpenRouter key.
JEV_API_KEY=
# One selected record per JEV-enabled briefing; genuine saved responses are reused.
JEV_RECORD_ID=INC-001
CREWAI_TELEMETRY_DISABLED=true
OTEL_SDK_DISABLED=true
